APP_MODE=SANDBOX
DRY_RUN=true
DATABASE_URL=sqlite:///data/war_thunder_rent_bot.db
OTP_LOOKBACK_SECONDS=120
OTP_MIN_REQUEST_INTERVAL_SECONDS=30
EMAIL_SECRET_TTL_SECONDS=300
PASSWORD_RESET_TTL_SECONDS=900
# GMAIL_OAUTH_CLIENT_ID=owner-provided-client-id
# GMAIL_ALLOWED_SENDER=confirmed-sender-from-sanitized-fixture
# Pixel Storm live validation is owner-gated and disabled by default.
LIVE_PIXELSTORM_ENABLED=false
LIVE_PIXELSTORM_DESTRUCTIVE_CONFIRMED=false
